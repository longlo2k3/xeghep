{
  "name": "xeghep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/scripts/pushSchema.ts",
    "generate:types": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/scripts/generateTypes.ts",
    "seed": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/seed/seed.ts",
    "seed:export-db": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/seed/exportDatabaseSnapshot.ts",
    "seed:snapshot": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/seed/seedDatabaseSnapshot.ts",
    "seed:admin": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/seed/seedAdmin.ts",
    "seed:legacy:media": "node --import tsx src/seed/seedMedia.ts",
    "seed:legacy:routes": "node --import tsx src/seed/seedRoutes.ts",
    "seed:legacy:pages": "node --import tsx src/seed/seedPages.ts",
    "seed:legacy:articles": "node --import tsx src/seed/seedArticles.ts",
    "seed:legacy:airport": "node --import tsx src/seed/seedAirport.ts",
    "seed:legacy:distance": "node --import tsx src/seed/seedDistance.ts",
    "seed:legacy:redirects": "node --import tsx src/seed/seedRedirects.ts",
    "seed:legacy:company": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/seed/seedCompany.ts",
    "seed:legacy:pricing": "node --import tsx src/seed/seedPricingSettings.ts",
    "seed:users": "node --require ./src/scripts/tsxUserInfoFallback.cjs --import tsx src/seed/seedUsers.ts",
    "anonymize:pii": "node --import tsx src/seed/anonymizePii.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "~15.4.11",
    "payload": "^3.90.2",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.2",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "~15.4.11",
    "jsdom": "^26.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
