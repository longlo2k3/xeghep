# =====================================================
# Xe Ghép — dự án gộp (website + admin CMS + Payload backend)
# CHỈ tên biến, KHÔNG secret thật. Copy thành .env.local rồi điền giá trị.
# =====================================================

# --- Payload CMS / Postgres ---
DATABASE_URI=postgresql://user:password@localhost:5432/dbname
PAYLOAD_SECRET=
# Origin public để build URL /media tuyệt đối (SEO/OG); production: https://xegheplientinh.vn
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
# true khi muốn Drizzle tự push schema lúc dev (xem npm run db:push)
PAYLOAD_DB_PUSH=false

# --- Ứng dụng gộp (một app, một port — D6/D10) ---
# SSR/middleware fetch API nội bộ; mặc định code = http://localhost:3000 (trỏ về chính app)
CMS_URL=http://localhost:3000
# Tuỳ chọn: override origin CMS phía client (mặc định rỗng = relative /api/...)
NEXT_PUBLIC_CMS_URL=
# Tuỳ chọn: baseURL API của Admin SPA (mặc định /api)
NEXT_PUBLIC_API_URL=

# --- Bảo mật nghiệp vụ ---
LOOKUP_SECRET=
IP_SALT=

# --- Tinh chỉnh (tuỳ chọn) ---
# Thời gian tối thiểu trước giờ khởi hành khi đặt xe (phút)
MIN_LEAD_TIME_MINUTES=

# --- Seed (npm run seed:*) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
SEED_DISPATCHER_EMAIL=
SEED_DISPATCHER_PASSWORD=
# Thư mục ảnh nguồn khi seed media trỏ vào file public
SEED_IMAGE_SOURCE_DIR= 
# Số tháng ẩn PII khi chạy anonymize:pii
ANONYMIZE_MONTHS=
